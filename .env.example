# ===========================
# SUPABASE CONFIGURATION
# ===========================
# Obtenha essas chaves no dashboard do Supabase: https://supabase.com/dashboard
VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# (OpenAI, Stripe Secret, and Supabase Service Role configurations have been moved to api/.env for security)

# ===========================
# STRIPE CONFIGURATION (Opcional)
# ===========================
# Chave pública para pagamentos de análises e assinaturas
# Obtenha em: https://dashboard.stripe.com/apikeys
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# ===========================
# GOOGLE MAPS CONFIGURATION (Opcional)
# ===========================
# Para geocodificação e visualização de mapas das agências
# Obtenha em: https://console.cloud.google.com/
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ===========================
# BACKEND API URL
# ===========================
VITE_API_URL=http://localhost:3001
# Em produção: VITE_API_URL=https://estagionauta-api-991344207740.southamerica-east1.run.app

# ===========================
# TEST CONFIGURATION (Optional for E2E tests)
# ===========================
TEST_USER_EMAIL=your_test_user_email_here
TEST_USER_PASSWORD=your_test_user_password_here
