# Ignore file for Google Cloud SDK (gcloud) upload

# Node.js dependencies and build artifacts
node_modules/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Environment and sensitive files
.env
.env.*
!.env.example

# Git config and meta
.git/
.gitignore
.gcloudignore
.dockerignore

# OS specific files
.DS_Store
Thumbs.db
